@{
    ViewData["Title"] = "Home";
}

<div class="text-center mt-5">
    <h1 class="display-3 fw-bold">Welcome to JokeHub</h1>

    <p class="lead mt-3">
        A place to discover and share jokes with everyone.
    </p>

    <p class="mt-4">
        <a asp-controller="Jokes"
           asp-action="Index"
           class="btn btn-primary btn-lg">
            Explore Jokes
        </a>
    </p>

    @if (User.Identity?.IsAuthenticated != true)
    {
        <p class="mt-3">
            Have a joke to share?
            <a asp-area="Identity"
               asp-page="/Account/Register">
                Create an account
            </a>
            to get started.
        </p>
    }
    else
    {
        <p class="mt-3">
            Ready to make someone laugh?
            <a asp-controller="Jokes" asp-action="Create">
                Submit a joke
            </a>.
        </p>
    }
</div>
