@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<h1>@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-5">
        <section>
            <form id="account" method="post">
                <h2>Welcome back to JokeHub.</h2>
                <p>Log in to share your jokes with the community.</p>
                <hr />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger"
                     role="alert"></div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Email"
                           class="form-control"
                           autocomplete="username"
                           aria-required="true"
                           placeholder="name@example.com" />
                    <label asp-for="Input.Email">Email</label>
                    <span asp-validation-for="Input.Email"
                          class="text-danger"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Password"
                           class="form-control"
                           autocomplete="current-password"
                           aria-required="true"
                           placeholder="Password" />
                    <label asp-for="Input.Password">Password</label>
                    <span asp-validation-for="Input.Password"
                          class="text-danger"></span>
                </div>

                <div class="checkbox mb-3">
                    <label asp-for="Input.RememberMe">
                        <input class="form-check-input"
                               asp-for="Input.RememberMe" />
                        Remember me
                    </label>
                </div>

                <button id="login-submit"
                        type="submit"
                        class="w-100 btn btn-lg btn-primary">
                    Log in
                </button>

                <div class="mt-3">
                    <p>
                        <a asp-page="./ForgotPassword">
                            Forgot your password?
                        </a>
                    </p>

                    <p>
                        Don't have an account?
                        <a asp-page="./Register"
                           asp-route-returnUrl="@Model.ReturnUrl">
                            Register here
                        </a>
                    </p>

                    <p>
                        <a asp-page="./ResendEmailConfirmation">
                            Resend email confirmation
                        </a>
                    </p>
                </div>
            </form>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

